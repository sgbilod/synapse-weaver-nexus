{
  "name": "synapse-weaver-nexus",
  "version": "0.1.0",
  "description": "The Sentient Development Environment. An AI-orchestrated platform for total development lifecycle automation.",
  "private": true,
  "scripts": {
    "start:ui": "npm run dev --workspace=packages/ui-desktop",
    "start:nexus": "npm run start --workspace=packages/nexus-core",
    "start": "npm-run-all --parallel start:nexus start:ui",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint packages/ --ext .ts,.tsx --report-unused-disable-directives",
    "type-check": "tsc -p tsconfig.base.json --noEmit",
    "coverage:ui": "npm run test --workspace=packages/ui-desktop -- --coverage"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "babel-jest": "^29.7.0",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^29.5.12",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "identity-obj-proxy": "^3.0.0",
    "react-test-renderer": "18.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
