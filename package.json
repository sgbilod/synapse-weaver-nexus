{
  "name": "synapse-weaver-nexus",
  "version": "0.1.0",
  "description": "The Sentient Development Environment. An AI-orchestrated platform for total development lifecycle automation.",
  "private": true,
  "scripts": {
    "start:ui": "npm run dev --workspace=packages/ui-desktop",
    "start:nexus": "npm run start --workspace=packages/nexus-core",
    "start": "npm-run-all --parallel start:nexus start:ui",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint packages/ --ext .ts,.tsx --report-unused-disable-directives"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^29.5.12",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
