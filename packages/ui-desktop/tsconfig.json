{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "index.html"],
  "exclude": ["node_modules", "dist", "dist-electron", "tests"]
}
