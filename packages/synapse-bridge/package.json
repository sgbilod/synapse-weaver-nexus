{
  "name": "@synapse/synapse-bridge",
  "version": "0.1.0",
  "description": "VS Code extension bridge for agent coordination and command routing.",
  "main": "dist/extension.js",
  "types": "dist/extension.d.ts",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "synapse-weaver.activate",
        "title": "Synapse Weaver: Activate"
      }
    ],
    "keybindings": [
      {
        "command": "synapse-weaver.activate",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@synapse/nexus-core": "^0.1.0",
    "@types/glob": "^9.0.0",
    "@types/vscode": "^1.104.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
